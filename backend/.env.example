PORT=4000
JWT_SECRET=change-this-to-a-long-random-secret-key
NODE_ENV=development

# Google OAuth (optional — for Google login)
GOOGLE_CLIENT_ID=

# Admin wallet address (first user with this address gets admin role)
ADMIN_WALLET=0xYourWalletAddress

# Frontend URL (for CORS and redirects)
FRONTEND_URL=https://kafugames.com
